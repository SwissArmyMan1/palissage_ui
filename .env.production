# Production build config (read by `vite build` on Vercel).
#
# Every value here is public client-side config — VITE_* vars are inlined into the
# browser bundle, so there are no secrets to protect. Committing it keeps the Vercel
# build self-contained: a push triggers a rebuild that runs against the live chain
# instead of falling back to offline-demo/mock mode.
#
# Live Arbitrum Sepolia deployment (chain id 421614), deployed 2026-06-14 via
# script/Deploy.s.sol. See deployments/arbitrum-sepolia.md.

VITE_CHAIN_ID=421614
VITE_ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# WalletConnect / mobile-QR project id (public client id). Injected wallets
# (MetaMask/Rabby/Coinbase) work without it.
VITE_WALLETCONNECT_PROJECT_ID=4029288fe07c332414018bcf72a32a41

# Payment token — Monerium EURe (18 decimals).
VITE_EURE_ADDRESS=0xFdEed5cE7E281B4e0F163B70eBe2Cf0B10803b7B

# Deployed Palissage protocol contracts.
VITE_WINE_LOT_TOKEN_ADDRESS=0x0fef031115E60105c09458E4e28031DaF62D1AbD
VITE_PRIMARY_MARKET_ADDRESS=0x98EDC97B03Ae9901D4Af73F62dbF3C10F3927fA1
VITE_SECONDARY_MARKET_ADDRESS=0x4F0862a4346A3EB88545F66B3E0b423966F6aCe0
VITE_REDEMPTION_MANAGER_ADDRESS=0x67C05db79223707635f9F386C57227AFe1C782aE
VITE_IDENTITY_REGISTRY_ADDRESS=0x313d7a63c717ad25a0c49BFBaa8fe142CD28E0bd
VITE_TRUSTED_ISSUERS_REGISTRY_ADDRESS=0x798Cc1a405Eb3bC6179Db81De5a9d1e5b2349201
VITE_CLAIM_ISSUER_ADDRESS=0x960ba1FE7eCb3753Ae1D7d2cf1304aaAd0d19D4d
VITE_ROLE_GATEWAY_ADDRESS=0x6ee8A97e14Ce92c6DC27166880CD985D24897f88
