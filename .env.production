# Production build configuration, read by `vite build`.
#
# Committed on purpose: every value is public client-side config, and keeping it
# in the repository means a push produces a build that runs against the live
# chain instead of falling back to an unconfigured state.
#
# Base Sepolia (84532), protocol version 1.0.0-mvp, all contracts verified.
# Source of truth: deployments/palissage-84532.addresses.json.

# Left empty on purpose. Setting it puts that endpoint first, ahead of the
# order measured in src/chain/config.ts — and the endpoint that was pinned here
# is the one that throttled a page load. Point it at a private node when there
# is one.
VITE_BASE_SEPOLIA_RPC_URL=

# WalletConnect / mobile-QR project id (public client id).
VITE_WALLETCONNECT_PROJECT_ID=4029288fe07c332414018bcf72a32a41

# Settlement asset — EURC (Circle), 6 decimals. Deployed and upgraded by Circle.
VITE_PAYMENT_TOKEN_ADDRESS=0x808456652fdb597867f38412077A9182bf77359F

# Identity layer
VITE_TRUSTED_ISSUERS_REGISTRY_ADDRESS=0x798Cc1a405Eb3bC6179Db81De5a9d1e5b2349201
VITE_IDENTITY_REGISTRY_ADDRESS=0x313d7a63c717ad25a0c49BFBaa8fe142CD28E0bd
VITE_CLAIM_ISSUER_ADDRESS=0xD05a0B4B5Cd522Cc175C1eB0DA857212b42E1074
VITE_ROLE_GATEWAY_ADDRESS=0x23083F4d7048B31627631510DC73a5a56D630840

# Asset, markets and redemption
VITE_WINE_LOT_TOKEN_ADDRESS=0x0fef031115E60105c09458E4e28031DaF62D1AbD
VITE_PRIMARY_MARKET_ADDRESS=0x98EDC97B03Ae9901D4Af73F62dbF3C10F3927fA1
VITE_SECONDARY_MARKET_ADDRESS=0x4F0862a4346A3EB88545F66B3E0b423966F6aCe0
VITE_REDEMPTION_MANAGER_ADDRESS=0x67C05db79223707635f9F386C57227AFe1C782aE

# Read model
VITE_PALISSAGE_LENS_ADDRESS=0x36C5f43919CB220A7368c2E3bC373B378D0eE7B6
