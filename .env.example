# Palissage web — client configuration.
#
# Every VITE_* value is inlined into the browser bundle, so there are no secrets
# here. Defaults for all of them are the live Base Sepolia deployment; you only
# need this file to point the interface somewhere else.

# --- Network -----------------------------------------------------------------
# Optional private or override RPC. The build falls back to Base's public
# endpoint plus two others, in that order.
VITE_BASE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id (https://cloud.reown.com). Required only for
# the mobile-QR option; injected wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Settlement asset --------------------------------------------------------
# EURC (Circle) on Base Sepolia, 6 decimals.
VITE_PAYMENT_TOKEN_ADDRESS=

# --- Deployed Palissage contracts -------------------------------------------
# From deployments/palissage-84532.addresses.json.
VITE_WINE_LOT_TOKEN_ADDRESS=
VITE_PRIMARY_MARKET_ADDRESS=
VITE_SECONDARY_MARKET_ADDRESS=
VITE_REDEMPTION_MANAGER_ADDRESS=
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_TRUSTED_ISSUERS_REGISTRY_ADDRESS=
VITE_CLAIM_ISSUER_ADDRESS=
VITE_ROLE_GATEWAY_ADDRESS=
VITE_PALISSAGE_LENS_ADDRESS=
